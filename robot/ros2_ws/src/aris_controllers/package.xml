<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aris_controllers</name>
  <version>0.1.0</version>
  <description>aris_joint_impedance_controller: joint impedance around the certified trajectory, pen force fed forward.</description>
  <maintainer email="wernerpe.mail@gmail.com">Peter Werner</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>pluginlib</depend>
  <depend>realtime_tools</depend>
  <depend>std_srvs</depend>
  <depend>aris_msgs</depend>
  <depend>eigen</depend>
  <depend>franka_semantic_components</depend>
  <depend>libfranka</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <controller_interface plugin="${prefix}/aris_controllers.xml"/>
  </export>
</package>
